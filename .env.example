# Copy to .env and adjust. Local-only stack — no secrets or API keys needed.

# Postgres (Docker Compose)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-local-only
POSTGRES_DB=swiss_legal_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag-local-only@localhost:5432/swiss_legal_rag

# Ollama (embeddings + generation)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen3:4b

# Cross-encoder reranker (runs on CPU via sentence-transformers)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
