# Copy to .env and adjust. Local-only stack — no secrets or API keys needed.

# Postgres (Docker Compose)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-local-only
POSTGRES_DB=swiss_legal_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag-local-only@localhost:5432/swiss_legal_rag

# Ollama (embeddings + generation)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct

# Cross-encoder reranker (runs on CPU via sentence-transformers)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Optional: pin the exact reranker weights by Hugging Face revision (commit hash
# or tag) for reproducible reranking. Empty = latest revision of RERANKER_MODEL.
RERANKER_REVISION=

# Optional: python.exe of apps/ingestion/.venv used by POST /ingest.
# Empty = auto-derived from the repo layout.
INGESTION_PYTHON=

# Base URL of the retrieval API, used by apps/evals when scoring gold questions.
EVALS_API_BASE_URL=http://localhost:8000

# Opt-in retrieval API security (both off by default — see apps/retrieval/README.md
# Security); no restart is required
# to keep the API open unless you set these.
# API key required as the X-API-Key header on every endpoint except /health and
# /ready. Empty = no authentication.
API_KEY=
# Per-client-IP requests/minute allowed on POST /search, /chat, /ingest. 0 = disabled.
RATE_LIMIT_PER_MINUTE=0
