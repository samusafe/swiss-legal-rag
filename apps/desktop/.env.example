# Base URL of the retrieval API (apps/retrieval). Build-time (Vite) variable.
VITE_API_BASE_URL=http://localhost:8000

# Show the expandable model-reasoning disclosure in the chat transcript.
# Debug feature, off by default — raw model reasoning can be unpredictable.
# Build-time (Vite) variable.
VITE_SHOW_THINKING=false

# API key sent as X-API-Key on every request, for a retrieval API configured
# with API_KEY (see apps/retrieval README Security). Empty by default — matches
# the retrieval API's own opt-in auth, which is off unless API_KEY is set there.
# Build-time (Vite) variable.
VITE_API_KEY=
